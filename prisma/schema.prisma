// Slab Ledger — data model
// See the design plan for the rationale behind this shape (Card vs. Holding vs.
// PriceSnapshot vs. PortfolioSnapshot).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A single collector's account. Phase 1 is single-user in practice, but every
/// row is scoped by userId from day one so multi-user is additive later, not
/// a migration.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  cards              Card[]
  holdings           Holding[]
  portfolioSnapshots PortfolioSnapshot[]
}

/// A catalog entry: one distinct card + parallel. Freeform fields (phase 1
/// decision) — no external checklist lookup yet.
model Card {
  id         String   @id @default(cuid())
  userId     String
  sport      String
  year       Int
  setName    String
  cardNumber String
  player     String
  parallel   String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings       Holding[]
  priceSnapshots PriceSnapshot[]

  @@index([userId])
  @@index([userId, sport, year, setName, player])
}

enum HoldingStatus {
  OWNED
  SOLD
}

/// A copy you actually own (or owned) of a Card. One Card can back many
/// Holdings — a raw and a PSA 10 of the same parallel are two Holdings.
model Holding {
  id             String        @id @default(cuid())
  userId         String
  cardId         String
  grade          String // e.g. "Raw", "PSA 10", "BGS 9.5"
  serialNumber   String? // e.g. "142/499"
  quantity       Int           @default(1)
  purchasePrice  Decimal       @db.Decimal(10, 2)
  purchaseDate   DateTime
  purchaseSource String?
  status         HoldingStatus @default(OWNED)
  soldPrice      Decimal?      @db.Decimal(10, 2)
  soldDate       DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cardId])
}

enum PriceSource {
  MANUAL
  EBAY_SOLD
}

/// One observation of the market for a Card + grade. Phase 1 only ever
/// writes source = MANUAL; the EBAY_SOLD source and confidence scoring are
/// wired up by the phase 2 pricing pipeline.
model PriceSnapshot {
  id          String      @id @default(cuid())
  cardId      String
  grade       String
  source      PriceSource @default(MANUAL)
  observedAt  DateTime    @default(now())
  medianPrice Decimal     @db.Decimal(10, 2)
  sampleSize  Int         @default(1)
  confidence  Decimal     @db.Decimal(3, 2) @default(1)
  notes       String?
  // Optional visual receipt for a manually-logged price: the listing you
  // were looking at, and its photo (hotlinked, never re-hosted — see the
  // design plan's Visual verification section).
  listingUrl  String?
  imageUrl    String?
  createdAt   DateTime    @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, grade, observedAt])
}

/// A dated rollup of the whole collection, recorded on demand in phase 1
/// (a scheduler takes over in phase 2). Never hand-entered — always computed
/// from Holdings + the latest matching PriceSnapshot at record time.
model PortfolioSnapshot {
  id          String   @id @default(cuid())
  userId      String
  asOfDate    DateTime @default(now())
  costBasis   Decimal  @db.Decimal(12, 2)
  marketValue Decimal  @db.Decimal(12, 2)
  gain        Decimal  @db.Decimal(12, 2)
  gainPct     Decimal  @db.Decimal(7, 2)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, asOfDate])
}
